---
import type { MarkdownHeading } from 'astro'
import type { ImageMetadata } from 'astro'
import Header from '../components/Header.astro'
import Sidebar from '../components/Sidebar.astro'
import TableOfContents from '../components/TableOfContents.astro'
import { topicForCategory, topicHref } from '../lib/docs'
import { defaultLocale, getUi, localePath, type Locale, type LocaleLink } from '../lib/i18n'
import BaseLayout from './BaseLayout.astro'

interface DocLink {
  href: string
  title: string
}

interface Props {
  title: string
  description: string
  keywords?: string[]
  headings: MarkdownHeading[]
  category: string
  lastUpdated?: Date
  aiTranslated?: boolean
  sourcePath: string
  readingMinutes: number
  editHref: string
  previous?: DocLink
  next?: DocLink
  image?: {
    src: ImageMetadata
    alt: string
  }
  locale?: Locale
  localeLinks?: LocaleLink[]
}

const {
  title,
  description,
  keywords,
  headings,
  category,
  lastUpdated,
  aiTranslated = false,
  sourcePath,
  readingMinutes,
  editHref,
  previous,
  next,
  image,
  locale = defaultLocale,
  localeLinks = [],
} = Astro.props
const ui = getUi(locale)
const topic = topicForCategory(category, locale)
const englishVersion = localeLinks.find((link) => link.locale === defaultLocale)
const updated = lastUpdated
  ? new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric' }).format(lastUpdated)
  : undefined
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  pageType="article"
  lastUpdated={lastUpdated}
  locale={locale}
  localeLinks={localeLinks}
>
  <Header
    mobileBack={{ href: topicHref(category, locale), label: topic.name }}
    editHref={editHref}
    locale={locale}
    localeLinks={localeLinks}
  />
  <div class="docs-shell">
    <Sidebar locale={locale} />
    <main class="article" data-pagefind-body>
      <nav class="breadcrumbs" aria-label={ui.breadcrumb} data-pagefind-ignore>
        <a href={localePath(locale)}>{ui.wiki}</a>
        <span aria-hidden="true">/</span>
        <a href={topicHref(category, locale)}>{topic.name}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <article>
        <header class="article-header">
          <span class="article-kind">{ui.guide}</span>
          <h1 data-pagefind-meta="title">{title}</h1>
          {aiTranslated && (
            <aside class="ai-translation-notice" role="note" data-pagefind-ignore>
              <span class="ai-translation-badge" aria-hidden="true">AI</span>
              <div>
                <strong>{ui.aiTranslatedTitle}</strong>
                <p>
                  {ui.aiTranslatedWarning}
                  {englishVersion && (
                    <> <a href={englishVersion.href}>{ui.viewEnglishVersion} →</a></>
                  )}
                </p>
              </div>
            </aside>
          )}
          <span class="sr-only" data-pagefind-meta="category">{topic.name}</span>
          <div class="article-meta" data-pagefind-ignore>
            {updated && <span>{ui.updated} {updated}</span>}
            <span>{ui.readingMinutes(readingMinutes)}</span>
            <span>{sourcePath}</span>
            <a href={editHref}>{ui.editOnGitHub}</a>
          </div>
          <p>{description}</p>
        </header>

        {headings.length > 0 && (
          <details class="mobile-table-of-contents" data-pagefind-ignore>
            <summary>{ui.onThisPage}</summary>
            <ol>
              {headings.filter((heading) => heading.depth === 2 || heading.depth === 3).map((heading) => (
                <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ol>
          </details>
        )}
        <div class="article-content">
          <slot />
        </div>
      </article>

      <section class="article-feedback" aria-labelledby="feedback-title" data-pagefind-ignore>
        <h2 id="feedback-title">{ui.wasHelpful}</h2>
        <div>
          <button type="button" data-feedback="yes">{ui.yes}</button>
          <button type="button" data-feedback="no">{ui.no}</button>
        </div>
        <p aria-live="polite"></p>
      </section>

      <a class="article-edit-card" href={editHref} data-pagefind-ignore>
        <span>{ui.editThisPage}</span><span aria-hidden="true">↗</span>
      </a>

      {(previous || next) && (
        <nav class="article-pagination" aria-label={ui.articlePagination} data-pagefind-ignore>
          {previous ? <a href={previous.href}>← {previous.title}</a> : <span />}
          {next && <a href={next.href}>{next.title} →</a>}
        </nav>
      )}
    </main>
    <TableOfContents headings={headings} locale={locale} />
  </div>

  <script is:inline define:vars={{ feedbackThanks: ui.feedbackThanks }}>
    document.querySelectorAll('[data-feedback]').forEach((button) => {
      button.addEventListener('click', () => {
        const group = button.closest('.article-feedback')
        group?.querySelectorAll('[data-feedback]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)))
        const status = group?.querySelector('p')
        if (status) status.textContent = feedbackThanks
      })
    })
  </script>
</BaseLayout>
