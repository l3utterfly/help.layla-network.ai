---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import SeoHead from '../components/SeoHead.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'

interface SocialImage {
  src: ImageMetadata
  alt: string
}

interface Props {
  title: string
  description: string
  keywords?: string[]
  titleSuffix?: boolean
  image?: SocialImage
  pageType?: 'website' | 'article'
  lastUpdated?: Date
}

const {
  title,
  description,
  keywords = [],
  titleSuffix = true,
  image,
  pageType = 'website',
  lastUpdated,
} = Astro.props
const documentTitle = titleSuffix ? `${title} | Layla Help` : title
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
const generatedImage = image ? await getImage({ src: image.src }) : undefined
const socialImage = generatedImage
  ? {
      url: new URL(generatedImage.src, Astro.site ?? canonical),
      alt: image?.alt ?? title,
      width: Number(generatedImage.attributes.width),
      height: Number(generatedImage.attributes.height),
      type: `image/${generatedImage.options.format}`,
    }
  : {
      url: new URL('/meta.jpg', Astro.site ?? canonical),
      alt: 'Layla Help',
      width: 1024,
      height: 537,
      type: 'image/jpeg',
    }
const structuredData = {
  '@context': 'https://schema.org',
  '@type': pageType === 'article' ? 'TechArticle' : 'WebPage',
  ...(pageType === 'article' ? { headline: title } : { name: title }),
  description,
  url: canonical.href,
  image: socialImage.url.href,
  ...(lastUpdated ? { dateModified: lastUpdated.toISOString() } : {}),
  isPartOf: {
    '@type': 'WebSite',
    name: 'Layla Help',
    url: new URL('/', Astro.site ?? Astro.url.origin).href,
  },
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{documentTitle}</title>
    <SeoHead
      title={documentTitle}
      description={description}
      canonical={canonical}
      image={socialImage.url}
      imageAlt={socialImage.alt}
      imageWidth={socialImage.width}
      imageHeight={socialImage.height}
      imageType={socialImage.type}
      keywords={keywords}
      pageType={pageType}
      lastUpdated={lastUpdated}
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <div class="ambient-glow" aria-hidden="true"></div>
    <div class="site-stage">
      <slot />
    </div>
    <Footer />
  </body>
</html>
