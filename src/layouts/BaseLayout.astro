---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import SeoHead from '../components/SeoHead.astro'
import Footer from '../components/Footer.astro'
import {
  defaultLocale,
  getUi,
  languagePreferenceKey,
  localeMetadata,
  locales,
  type Locale,
  type LocaleLink,
} from '../lib/i18n'
import '../styles/global.css'

interface SocialImage {
  src: ImageMetadata
  alt: string
}

interface Props {
  title: string
  description: string
  keywords?: string[]
  titleSuffix?: boolean
  image?: SocialImage
  pageType?: 'website' | 'article'
  lastUpdated?: Date
  locale?: Locale
  localeLinks?: LocaleLink[]
}

const {
  title,
  description,
  keywords = [],
  titleSuffix = true,
  image,
  pageType = 'website',
  lastUpdated,
  locale = defaultLocale,
  localeLinks = [],
} = Astro.props
const ui = getUi(locale)
const localeDetails = localeMetadata[locale]
const documentTitle = titleSuffix ? `${title} | Layla Help` : title
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
const alternateLocales = localeLinks.map((link) => ({
  locale: link.locale,
  url: new URL(link.href, Astro.site ?? canonical),
}))
const localeRedirects = Object.fromEntries(localeLinks.map((link) => [link.locale, link.href]))
const generatedImage = image ? await getImage({ src: image.src }) : undefined
const socialImage = generatedImage
  ? {
      url: new URL(generatedImage.src, Astro.site ?? canonical),
      alt: image?.alt ?? title,
      width: Number(generatedImage.attributes.width),
      height: Number(generatedImage.attributes.height),
      type: `image/${generatedImage.options.format}`,
    }
  : {
      url: new URL('/meta.jpg', Astro.site ?? canonical),
      alt: 'Layla Help',
      width: 1024,
      height: 537,
      type: 'image/jpeg',
    }
const structuredData = {
  '@context': 'https://schema.org',
  '@type': pageType === 'article' ? 'TechArticle' : 'WebPage',
  ...(pageType === 'article' ? { headline: title } : { name: title }),
  description,
  url: canonical.href,
  image: socialImage.url.href,
  inLanguage: locale,
  ...(lastUpdated ? { dateModified: lastUpdated.toISOString() } : {}),
  isPartOf: {
    '@type': 'WebSite',
    name: 'Layla Help',
    url: new URL('/', Astro.site ?? Astro.url.origin).href,
  },
}
---

<!doctype html>
<html lang={locale} dir={localeDetails.direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <script
      is:inline
      define:vars={{
        currentLocale: locale,
        defaultLocale,
        languagePreferenceKey,
        localeRedirects,
        locales,
      }}
    >
      (() => {
        const normalizeLocale = (value) => value?.toLowerCase().split('-')[0]

        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return

          const link = event.target.closest('[data-language-locale]')
          const selectedLocale = normalizeLocale(link?.dataset.languageLocale)
          if (!selectedLocale || !locales.includes(selectedLocale)) return

          try {
            localStorage.setItem(languagePreferenceKey, selectedLocale)
          } catch {
            // Language detection still works when storage is unavailable.
          }
        })

        if (currentLocale !== defaultLocale) return

        let storedLocale
        try {
          storedLocale = normalizeLocale(localStorage.getItem(languagePreferenceKey))
        } catch {
          // Fall back to browser languages when storage is unavailable.
        }

        const preferredLocale = locales.includes(storedLocale)
          ? storedLocale
          : (navigator.languages?.length ? navigator.languages : [navigator.language])
              .map(normalizeLocale)
              .find((candidate) => locales.includes(candidate))

        if (!preferredLocale || preferredLocale === currentLocale) return

        const redirectPath = localeRedirects[preferredLocale]
        if (!redirectPath) return

        const redirectUrl = new URL(redirectPath, window.location.origin)
        redirectUrl.search = window.location.search
        redirectUrl.hash = window.location.hash

        if (redirectUrl.href !== window.location.href) {
          window.location.replace(redirectUrl.href)
        }
      })()
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{documentTitle}</title>
    <SeoHead
      title={documentTitle}
      description={description}
      canonical={canonical}
      image={socialImage.url}
      imageAlt={socialImage.alt}
      imageWidth={socialImage.width}
      imageHeight={socialImage.height}
      imageType={socialImage.type}
      keywords={keywords}
      pageType={pageType}
      lastUpdated={lastUpdated}
      ogLocale={localeDetails.ogLocale}
      alternateLocales={alternateLocales}
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <div class="ambient-glow" aria-hidden="true"></div>
    <div class="site-stage">
      <slot />
    </div>
    <Footer ariaLabel={ui.communitySupport} />
  </body>
</html>
