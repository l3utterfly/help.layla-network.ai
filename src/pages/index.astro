---
import Header from '../components/Header.astro'
import TopicIcon from '../components/TopicIcon.astro'
import { docHref, getPublishedDocs, topicForCategory, topicHref, topics } from '../lib/docs'
import BaseLayout from '../layouts/BaseLayout.astro'

const docs = await getPublishedDocs()
const startHere = topics
  .flatMap((topic) => docs.filter((entry) => entry.data.category === topic.category))
  .slice(0, 3)
const recent = [...docs].sort((left, right) => {
  const leftDate = left.data.lastUpdated?.getTime() ?? 0
  const rightDate = right.data.lastUpdated?.getTime() ?? 0
  return rightDate - leftDate
}).slice(0, 3)
const articleLabel = (count: number) => count === 1 ? '1 article' : `${count} articles`
---

<BaseLayout
  title="Layla Help"
  titleSuffix={false}
  description="Guides and answers for using Layla, your private offline AI assistant."
>
  <Header />
  <main class="home" data-pagefind-body>
    <section class="home-hero">
      <h1 data-pagefind-meta="title">Everything about running Layla</h1>
      <p>Setup guides, model formats, characters, agents, and fixes for when something will not load.</p>
      <button class="home-search" type="button" data-site-search-trigger>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17">
          <path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
        </svg>
        <span>Search {docs.length} {docs.length === 1 ? 'article' : 'articles'}</span>
      </button>

    </section>

    <section class="home-section" id="guides" aria-labelledby="start-here">
      <h2 class="section-label" id="start-here">Start here</h2>
      <div class="start-list">
        {startHere.map((entry, index) => (
          <a class="start-card" href={docHref(entry.id)}>
            <span class="start-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="start-copy">
              <strong>{entry.data.title}</strong>
              <small>{topicForCategory(entry.data.category).name} · Guide</small>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-section" aria-labelledby="browse-topics">
      <h2 class="section-label" id="browse-topics">Browse by topic</h2>
      <div class="topic-grid">
        {topics.map((topic) => {
          const count = docs.filter((entry) => entry.data.category === topic.category).length
          return count > 0 ? (
            <a class="topic-card" href={topicHref(topic.category)}>
              <TopicIcon name={topic.icon} />
              <span class="topic-card-copy">
                <strong>{topic.name}</strong>
                <span>{articleLabel(count)}</span>
              </span>
            </a>
          ) : (
            <div class="topic-card topic-card-pending">
              <TopicIcon name={topic.icon} />
              <span class="topic-card-copy">
                <strong>{topic.name}</strong>
                <span>Coming soon</span>
              </span>
            </div>
          )
        })}
      </div>
    </section>

    <section class="home-section recent-section" aria-labelledby="recently-updated">
      <h2 class="section-label" id="recently-updated">Recently updated</h2>
      <div class="recent-list">
        {recent.map((entry) => (
          <a href={docHref(entry.id)}>
            <strong>{entry.data.title}</strong>
            <span>
              {entry.data.lastUpdated
                ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short' }).format(entry.data.lastUpdated)
                : 'Recently'}
              {' · '}{entry.id}
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-download" id="download" aria-labelledby="download-title">
      <h2 class="section-label" id="download-title">Get Layla</h2>
      <div class="download-badges">
        <a
          href="https://play.google.com/store/apps/details?id=com.layla"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Get Layla on Google Play (opens in a new tab)"
        >
          <img src="/google_badge.png" width="564" height="168" alt="Get it on Google Play" />
        </a>
        <a
          href="https://apps.apple.com/us/app/layla/id6456886656"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Download Layla on the App Store (opens in a new tab)"
        >
          <img src="/apple_badge.png" width="200" height="67" alt="Download on the App Store" />
        </a>
        <a
          href="https://www.layla-network.ai"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Get the official Layla APK (opens in a new tab)"
        >
          <img src="/directapk.png" width="386" height="112" alt="Direct download APK file" />
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
