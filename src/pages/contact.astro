---
import Header from '../components/Header.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const channels = [
  {
    label: 'Discord',
    title: 'Ask the community',
    copy: 'The fastest route for bug reports, model recommendations, and setup help. Developers read it regularly.',
    href: 'https://discord.gg/x546YJ6nYC',
    link: 'discord.gg/x546YJ6nYC',
  },
  {
    label: 'Email',
    title: 'Account, licence, and billing',
    copy: 'For anything involving a purchase or personal data. Replies may take a few business days.',
    href: 'mailto:info@layla-network.ai',
    link: 'info@layla-network.ai',
  },
  {
    label: 'GitHub',
    title: 'Docs source and issues',
    copy: 'Every page in this wiki is Markdown. Corrections and improvements are welcome as pull requests.',
    href: 'https://github.com/l3utterfly',
    link: 'github.com/l3utterfly',
  },
  {
    label: 'Reddit',
    title: 'Builds, models, and showcases',
    copy: 'Join longer conversations about model choices, prompt formats, and what people run on their devices.',
    href: 'https://www.reddit.com/r/layla_ai/',
    link: 'reddit.com/r/layla_ai',
  },
]
---

<BaseLayout title="Get help" description="Contact the Layla community and support team.">
  <Header mobileBack={{ href: '/', label: 'Wiki' }} />
  <main class="contact-page" data-pagefind-body>
    <header class="simple-page-header">
      <h1 data-pagefind-meta="title">Get help</h1>
      <p>Four places, different speeds. Search the wiki first—most answers are already here.</p>
    </header>

    <section class="contact-grid" aria-label="Support channels">
      {channels.map((channel) => (
        <a class="contact-card" href={channel.href}>
          <span>{channel.label}</span>
          <h2>{channel.title}</h2>
          <p>{channel.copy}</p>
          <strong>{channel.link} ↗</strong>
        </a>
      ))}
    </section>

    <aside class="privacy-note">
      Layla runs on your device. Support staff cannot see your chats, characters, or models, so include only the details you are comfortable sharing when reporting a problem.
    </aside>
  </main>
</BaseLayout>
