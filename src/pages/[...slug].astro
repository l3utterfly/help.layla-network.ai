---
import { render, type CollectionEntry } from 'astro:content'
import DocsLayout from '../layouts/DocsLayout.astro'
import { getArticleSeoImage } from '../lib/articleSeo'
import { docHref, docSlug, estimateReadingMinutes, getPublishedDocs } from '../lib/docs'

interface DocLink {
  href: string
  title: string
}

interface Props {
  entry: CollectionEntry<'docs'>
  previous?: DocLink
  next?: DocLink
}

export async function getStaticPaths() {
  const docs = await getPublishedDocs()

  return docs.map((entry) => {
    const categoryDocs = docs.filter((candidate) => candidate.data.category === entry.data.category)
    const categoryIndex = categoryDocs.findIndex((candidate) => candidate.id === entry.id)

    return {
      params: { slug: docSlug(entry.id) },
      props: {
        entry,
        previous: categoryIndex > 0
          ? { href: docHref(categoryDocs[categoryIndex - 1].id), title: categoryDocs[categoryIndex - 1].data.title }
          : undefined,
        next: categoryIndex < categoryDocs.length - 1
          ? { href: docHref(categoryDocs[categoryIndex + 1].id), title: categoryDocs[categoryIndex + 1].data.title }
        : undefined,
      },
    }
  })
}

const { entry, previous, next } = Astro.props
const { Content, headings } = await render(entry)
const readingMinutes = estimateReadingMinutes(entry.body ?? '')
const sourceFile = entry.filePath ?? `src/content/docs/${entry.id}.md`
const sourcePath = sourceFile.replace(/^src\/content\/docs\//, '')
const editHref = `https://github.com/l3utterfly/help.layla-network.ai/edit/main/${sourceFile}`
const image = getArticleSeoImage(entry)
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  keywords={entry.data.keywords}
  headings={headings}
  category={entry.data.category}
  lastUpdated={entry.data.lastUpdated}
  sourcePath={sourcePath}
  readingMinutes={readingMinutes}
  editHref={editHref}
  previous={previous}
  next={next}
  image={image}
>
  <Content />
</DocsLayout>
