---
import { render, type CollectionEntry } from 'astro:content'
import DocsLayout from '../layouts/DocsLayout.astro'
import { docHref, docSlug, estimateReadingMinutes, getPublishedDocs } from '../lib/docs'

interface DocLink {
  href: string
  title: string
}

interface Props {
  entry: CollectionEntry<'docs'>
  previous?: DocLink
  next?: DocLink
}

export async function getStaticPaths() {
  const docs = await getPublishedDocs()

  return docs.map((entry, index) => ({
    params: { slug: docSlug(entry.id) },
    props: {
      entry,
      previous: index > 0
        ? { href: docHref(docs[index - 1].id), title: docs[index - 1].data.title }
        : undefined,
      next: index < docs.length - 1
        ? { href: docHref(docs[index + 1].id), title: docs[index + 1].data.title }
        : undefined,
    },
  }))
}

const { entry, previous, next } = Astro.props
const { Content, headings } = await render(entry)
const readingMinutes = estimateReadingMinutes(entry.body ?? '')
const sourceFile = entry.filePath ?? `src/content/docs/${entry.id}.md`
const sourcePath = sourceFile.replace(/^src\/content\/docs\//, '')
const editHref = `https://github.com/l3utterfly/help.layla-network.ai/edit/main/${sourceFile}`
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  keywords={entry.data.keywords}
  headings={headings}
  category={entry.data.category}
  lastUpdated={entry.data.lastUpdated}
  sourcePath={sourcePath}
  readingMinutes={readingMinutes}
  editHref={editHref}
  previous={previous}
  next={next}
>
  <Content />
</DocsLayout>
