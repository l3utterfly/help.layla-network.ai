---
import octicons from '@primer/octicons'

interface Props {
  name: string
  class?: string
}

const { name, class: className } = Astro.props
const icon = octicons[name]
---

<span class:list={['topic-icon', className]} aria-hidden="true" set:html={icon.toSVG({ width: 24, height: 24, focusable: 'false' })} />
