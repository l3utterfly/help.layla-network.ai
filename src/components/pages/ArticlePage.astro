---
import { render } from 'astro:content'
import type { DocEntry } from '../../lib/docs'
import { estimateReadingMinutes, getArticleLocaleLinks } from '../../lib/docs'
import { getArticleSeoImage } from '../../lib/articleSeo'
import type { Locale } from '../../lib/i18n'
import DocsLayout from '../../layouts/DocsLayout.astro'

interface DocLink {
  href: string
  title: string
}

interface Props {
  entry: DocEntry
  locale: Locale
  previous?: DocLink
  next?: DocLink
}

const { entry, locale, previous, next } = Astro.props
const { Content, headings } = await render(entry)
const readingMinutes = estimateReadingMinutes(entry.body ?? '')
const sourceFile = entry.filePath ?? `src/content/docs/${entry.id}.md`
const sourcePath = sourceFile.replace(/^src\/content\/docs\//, '')
const editHref = `https://github.com/l3utterfly/help.layla-network.ai/edit/main/${sourceFile}`
const image = getArticleSeoImage(entry)
const localeLinks = await getArticleLocaleLinks(entry)
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  keywords={entry.data.keywords}
  headings={headings}
  category={entry.data.category}
  lastUpdated={entry.data.lastUpdated}
  aiTranslated={entry.data.ai_translated}
  sourcePath={sourcePath}
  readingMinutes={readingMinutes}
  editHref={editHref}
  previous={previous}
  next={next}
  image={image}
  locale={locale}
  localeLinks={localeLinks}
>
  <Content />
</DocsLayout>
