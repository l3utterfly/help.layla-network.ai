---
import octicons from '@primer/octicons'

const communityLinks = [
  { label: 'Email', href: 'mailto:info@layla-network.ai', icon: 'mail' },
  { label: 'Discord', href: 'https://discord.gg/x546YJ6nYC', icon: 'comment-discussion' },
  { label: 'GitHub', href: 'https://github.com/l3utterfly/layla-sdk', icon: 'mark-github' },
  { label: 'Website', href: 'https://www.layla-network.ai/', icon: 'globe' },
]

interface Props {
  ariaLabel?: string
  websiteLabel?: string
  location?: string
}

const {
  ariaLabel = 'Community and support',
  websiteLabel = 'Website',
  location = 'Gold Coast, Australia',
} = Astro.props
const localizedCommunityLinks = communityLinks.map((link) =>
  link.label === 'Website' ? { ...link, label: websiteLabel } : link
)
---

<footer class="site-footer" data-pagefind-ignore>
  <p>© {new Date().getFullYear()} Layla Network · {location}</p>
  <nav aria-label={ariaLabel}>
    {localizedCommunityLinks.map((link) => (
      <a href={link.href}>
        <span class="footer-channel-icon" aria-hidden="true" set:html={octicons[link.icon].toSVG({ width: 16, height: 16, focusable: 'false' })} />
        <span>{link.label}</span>
      </a>
    ))}
  </nav>
</footer>
