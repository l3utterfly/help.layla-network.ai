---
import Search from './react/Search'
import LanguageSwitcher from './LanguageSwitcher.astro'
import {
  defaultLocale,
  getUi,
  homeLocaleLinks,
  localePath,
  type Locale,
  type LocaleLink,
} from '../lib/i18n'

interface Props {
  mobileBack?: {
    href: string
    label: string
    meta?: string
  }
  editHref?: string
  locale?: Locale
  localeLinks?: LocaleLink[]
}

const {
  mobileBack,
  editHref,
  locale = defaultLocale,
  localeLinks = homeLocaleLinks(),
} = Astro.props
const ui = getUi(locale)
const homeHref = localePath(locale)
---

<header class:list={{ 'site-header': true, 'has-mobile-context': Boolean(mobileBack) }} data-pagefind-ignore>
  <div class="header-inner">
    <a class="brand" href={homeHref} aria-label={ui.siteHome}>
      <img class="brand-logo" src="/butterfly.png" width="1024" height="1024" alt="" />
      <span class="brand-copy">
        <span class="brand-name">LAYLA</span>
        <span class="brand-section">WIKI</span>
      </span>
    </a>

    <nav class="header-links" aria-label={ui.documentation}>
      <div class="header-text-links">
        <a href={`${homeHref}#guides`}>{ui.guides}</a>
        <a href="/faq/" hreflang="en">{ui.faq}</a>
        <a href="/contact/" hreflang="en">{ui.getHelp}</a>
      </div>
      <Search locale={locale} client:idle />
      <LanguageSwitcher locale={locale} localeLinks={localeLinks} />
      <a class="download-link" href={`${homeHref}#download`}>{ui.download}</a>
    </nav>
  </div>

  {mobileBack && (
    <div class="mobile-context-bar">
      <a href={mobileBack.href}>← {mobileBack.label}</a>
      {mobileBack.meta && <span>{mobileBack.meta}</span>}
      <div class="mobile-context-actions">
        {editHref && <a class="mobile-edit-link" href={editHref}>{ui.edit}</a>}
        <LanguageSwitcher locale={locale} localeLinks={localeLinks} compact />
      </div>
    </div>
  )}
</header>
